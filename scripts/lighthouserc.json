{
  "ci": {
    "collect": {
      "url": [
        "https://1901151458-prog.github.io/",
        "https://1901151458-prog.github.io/english-materials/",
        "https://1901151458-prog.github.io/UDHR/udhr/"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.75 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "artifacts/lighthouse"
    }
  }
}
